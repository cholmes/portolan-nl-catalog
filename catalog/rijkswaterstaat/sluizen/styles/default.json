      "source": "rws",
      "source-layer": "sluizen",
      "minzoom": 8,
      "layout": {
        "text-field": "{NAAM}",
        "text-size": 11,
        "text-offset": [0, 1.5],
        "text-font": ["Open Sans Regular"]
      },
      "paint": {
        "text-color": "#333333",
        "text-halo-color": "#FFFFFF",
        "text-halo-width": 1
